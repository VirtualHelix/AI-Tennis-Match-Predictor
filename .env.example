# Optional: enables updated descriptive match results; never commit a real key.
SPORTSTATS_KEY=

# Hosted server only: exact HTTPS origin, without a path.
COURTIQ_PUBLIC_ORIGIN=

# Optional paths. Defaults use this repository and its courtiq/model.py source.
# COURTIQ_ROOT=/absolute/path/to/AI-Tennis-Match-Predictor
# COURTIQ_MODEL_PATH=/absolute/path/to/models/courtiq/model.joblib
# COURTIQ_MODEL_CODE=/absolute/path/to/courtiq/model.py
